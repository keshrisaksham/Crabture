#!/bin/sh
set -e

SRC=/usr/share/crabture/nautilus-scripts
MARK="Crabture — Nautilus script"

# Put the right-click scripts (Nautilus: right-click ▸ Scripts) into one scripts folder.
# Never replaces a file that is not ours.
install_scripts() {
    dest="$1"; uid="$2"; gid="$3"
    [ -d "$SRC" ] || return 0
    for src in "$SRC"/*; do
        [ -f "$src" ] || continue
        target="$dest/$(basename "$src")"
        if [ -e "$target" ] && ! grep -qs "$MARK" "$target"; then
            continue
        fi
        install -m 0755 -o "$uid" -g "$gid" "$src" "$target" 2>/dev/null || true
    done
}

# Create "$1/.local/share/nautilus/scripts" owned by the user (every missing level).
make_scripts_dir() {
    home="$1"; uid="$2"; gid="$3"
    d="$home"
    for part in .local share nautilus scripts; do
        d="$d/$part"
        [ -d "$d" ] || install -d -m 0755 -o "$uid" -g "$gid" "$d" 2>/dev/null || return 1
    done
    return 0
}

install_right_click_entries() {
    # New users get them too.
    if [ -d /etc/skel ] && install -d -m 0755 /etc/skel/.local/share/nautilus/scripts 2>/dev/null; then
        install_scripts /etc/skel/.local/share/nautilus/scripts 0 0
    fi
    # Every regular user that already exists (their own Nautilus only reads their own folder).
    command -v getent >/dev/null 2>&1 || return 0
    getent passwd | while IFS=: read -r name _pw uid gid _gecos home shell; do
        [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
        case "$shell" in */nologin|*/false) continue ;; esac
        [ -d "$home" ] || continue
        make_scripts_dir "$home" "$uid" "$gid" || continue
        install_scripts "$home/.local/share/nautilus/scripts" "$uid" "$gid"
    done
}

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-remove" ] || [ "$1" = "abort-deconfigure" ]; then
    if command -v python3 >/dev/null 2>&1; then
        python3 -m compileall -q /usr/lib/crabture >/dev/null 2>&1 || true
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor || true
    fi
fi

if [ "$1" = "configure" ]; then
    install_right_click_entries || true
fi

exit 0
